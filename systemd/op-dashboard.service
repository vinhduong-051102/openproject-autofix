[Unit]
Description=op-dashboard - trang theo doi autofix (cong DASHBOARD_PORT trong .env)
After=network-online.target

[Service]
WorkingDirectory=@TOOL_DIR@
Environment=PATH=@EXTRA_PATH@:/usr/local/bin:/usr/bin:/bin
ExecStart=@PYTHON@ -u @TOOL_DIR@/op_dashboard.py
Restart=on-failure
RestartSec=30
# Khởi động lại dịch vụ chỉ dừng tiến trình chính: các lượt autofix / QA nó đã mở chạy tiếp (tắt máy vẫn bị ngắt,
# op_autofix.py --recover làm tiếp khi khởi động lại).
KillMode=process

[Install]
WantedBy=default.target
