# =====================================================================================================================
# op-watch / autofix / dashboard — cấu hình máy của bạn
#   cp .env.example .env   rồi sửa các giá trị dưới đây.
# Thứ tự ưu tiên: biến môi trường thật > .env > file JSON (~/.config/op-watch/*.json) > mặc định trong code.
# Giá trị rỗng (KEY=) = không đặt (dùng JSON / mặc định). Dùng được ${HOME}, ${TOOL_DIR} (thư mục chứa script) và ~.
# KHÔNG commit file .env (đã có trong .gitignore) — nó có thể chứa API key / mật khẩu.
# =====================================================================================================================

# ===== Dự án (đổi khi dùng tool cho dự án khác) =====
# Tiền tố mã ticket trên OpenProject: SOAR → SOAR-123; cũng là tag commit [SOAR-123] và tên thư mục lượt chạy.
OP_TICKET_PREFIX=SOAR
# Tên dự án dùng trong prompt (trống = tiền tố mã ticket)
OP_PROJECT_NAME=SOAR
# Tên người được giao / người duyệt quyết định (trống = tên tài khoản API trên OpenProject)
OP_ASSIGNEE_NAME=
# Mẫu tiêu đề ticket lỗi khi AI soạn task
TASK_TITLE_TEMPLATE=TCVN - <Phân hệ> - <Màn hình / chức năng> - Lỗi: <mô tả lỗi ngắn gọn, cụ thể>
# Gỡ xung đột tự động: regex đường dẫn file được gộp dòng của cả hai phía
AUTOFIX_UNION_INCLUDE=(^|/)db/master[\w-]*\.xml$
AUTOFIX_UNION_MERGE=(^|/)i18n/messages[\w-]*\.properties$
# Tên build-arg version khi build image BE
DEPLOY_VERSION_ARG=SOAR_VERSION

# ---- Đường dẫn chung -------------------------------------------------------------------------------------------------
# Thư mục chứa config.json / deploy.json / gitea.json / tokens/ (các file này vẫn được đọc nếu có).
OP_WATCH_CONFIG_DIR=~/.config/op-watch
# Trạng thái op-watch (việc đã thấy, comment đã báo…).
OP_WATCH_STATE=~/.local/state/op-watch/state.json
# Cache (token đăng nhập server test, tài khoản QA tự tạo).
OP_WATCH_CACHE_DIR=~/.cache/op-watch
# Thư mục thêm vào đầu PATH khi chạy (chứa lệnh claude, agy), cách nhau bằng dấu ":".
EXTRA_PATH=~/.local/bin

# ---- OpenProject -----------------------------------------------------------------------------------------------------
OP_URL=https://openproject.example.com
# API key: OpenProject → My account → Access tokens → API. (Bí mật — có thể để trong config.json thay vì ở đây.)
OP_API_KEY=
# Id dự án (số) hoặc identifier.
OP_PROJECT=123
# Trạng thái cần theo dõi: id:tên, cách nhau bằng dấu phẩy.
OP_WATCH_STATUSES=1:New,100:Reopened
# Chu kỳ kiểm tra (giây).
OP_INTERVAL=120
# File inbox markdown (mỗi sự kiện một dòng checklist).
OP_INBOX=~/op-watch-inbox.md
# Thông báo desktop (notify-send): true/false.
OP_NOTIFY=true
# Lệnh chạy khi có việc mới / reopen / comment (autofix).
OP_ON_CHANGE=python3 ${TOOL_DIR}/op_autofix.py
# Lệnh chạy định kỳ (chạy lại lượt bị ngắt, hàng chờ Claude xem lại…) và chu kỳ (giây); lượt đầu chạy ngay khi op-watch khởi động.
# định kỳ: Claude xem lại hàng chờ + dọn dữ liệu các bug đã chuyển người QA (tối đa 1 lần/giờ)
OP_ON_TICK=python3 ${TOOL_DIR}/op_autofix.py --recover; python3 ${TOOL_DIR}/op_autofix.py --followup-pending & python3 ${TOOL_DIR}/deploy_qa.py --review-watch & python3 ${TOOL_DIR}/cleanup.py --every 3600; wait
OP_TICK_INTERVAL=600
# Id trạng thái OpenProject dùng khi autofix cập nhật ticket.
OP_STATUS_RESOLVED=95
# Trường tuỳ chỉnh (kiểu User) ghi người làm trên ticket: autofix nhận ticket thì điền mình vào (trống mới điền).
# Để trống = tắt. OP_DEV_FIELD_OVERWRITE=1: ghi đè cả khi đã có dev khác.
OP_DEV_FIELD=Dev
OP_DEV_FIELD_OVERWRITE=0
# Ghi giờ làm lên ticket (Spent time): Claude sửa → activity OP_TIME_ACTIVITY_DEV, kiểm tra + Gemini test lại + QA
# server → OP_TIME_ACTIVITY_TEST. OP_SET_DATES: điền Start date (lúc nhận) / Finish date (lúc push + Resolved) nếu trống.
OP_LOG_TIME=1
OP_TIME_ACTIVITY_DEV=Development
OP_TIME_ACTIVITY_TEST=Testing
OP_SET_DATES=1
# Cần người quyết định → trạng thái này (null = không đổi).
OP_STATUS_REVIEW=94
# Bỏ bước Claude xem lại vì hết hạn mức → trạng thái này tới khi xem lại xong (null = không đổi).
OP_STATUS_FOLLOWUP=97

# ---- Autofix (Claude sửa bug trong worktree riêng) ------------------------------------------------------------------
AUTOFIX_ENABLED=true
# Sự kiện tự sửa: NEW, REOPENED.
AUTOFIX_EVENTS=NEW,REOPENED
# Thư mục làm việc (worktree, báo cáo, trạng thái, khoá).
AUTOFIX_ROOT=~/autofix
# Báo cáo tổng hợp mỗi lượt (mở nhanh).
AUTOFIX_REPORT_DIR=~/Downloads/autofix-reports
# Chỉ tự sửa ticket có số từ mức này (vd SOAR-1900 trở lên); chạy tay vẫn được.
AUTOFIX_MIN_TICKET_NUMBER=1
# Giới hạn chi phí một phiên Claude (USD).
AUTOFIX_MAX_BUDGET_USD=5
# Sửa xong + build/test qua → tự push nhánh cá nhân, comment, chuyển Resolved.
AUTOFIX_AUTO_SHIP=true
# Xung đột merge (ngoài db/master*.xml) → giao Claude gỡ.
AUTOFIX_CLAUDE_RESOLVE_CONFLICTS=true

# Repo FE / BE trên máy + nhánh cá nhân (BRANCH) và nhánh chung (UPSTREAM).
FE_REPO=${HOME}/soar-fe
FE_BRANCH=dev-ss-tencuaban
FE_UPSTREAM=dev-ss
BE_REPO=${HOME}/SOAR_BE
BE_BRANCH=develop-ss-tencuaban
BE_UPSTREAM=develop-ss
# Thư mục module Maven trong repo BE.
BE_SUBDIR=SOAR
# Node dùng để build FE (vite cần Node >= 18).
NODE_BIN=~/.nvm/versions/node/v22.0.0/bin

# Claude Code CLI.
CLAUDE_CMD=claude
# Model Claude (rỗng = mặc định của CLI).
CLAUDE_MODEL=

# Gemini (Antigravity CLI `agy`) xem lại bản sửa trước khi push + QA trên server test.
GEMINI_ENABLED=true
GEMINI_CMD=~/.local/bin/agy
GEMINI_MODEL=gemini-3.8-flash-high
GEMINI_TIMEOUT=900
# Gemini kết luận KHÔNG ĐẠT → không push.
GEMINI_BLOCK_ON_FAIL=true

# Các giá trị dưới chỉnh trên dashboard (ghi vào config.json, JSON thắng) — ở đây chỉ là giá trị ban đầu.
# Số lượt autofix chạy song song.
#AUTOFIX_MAX_PARALLEL=3
# Ngưỡng hạn mức Claude: 5 giờ (hoãn), 7 ngày (đổi gói), 7 ngày cho bước Claude xem lại.
#AUTOFIX_PAUSE_ABOVE_UTILIZATION=0.8
#AUTOFIX_SWITCH_ABOVE_7D=0.95
#AUTOFIX_FOLLOWUP_SKIP_ABOVE_7D=0.95
#AUTOFIX_AUTO_SWITCH=true
# Gói Claude (nhiều tài khoản) thêm trên dashboard; token lưu ở thư mục này (quyền 600).
#CLAUDE_TOKEN_DIR=~/.config/op-watch/tokens

# ---- Merge nhánh cá nhân vào nhánh chung qua Gitea (merge_to_dev.py) -------------------------------------------------
GITEA_URL=https://gitea.example.com
# Token Gitea (Settings → Applications, quyền repository read & write). Bí mật — có thể để trong gitea.json.
GITEA_TOKEN=
# Lịch chạy op-merge.timer (systemd OnCalendar, nhiều mốc cách nhau bằng ";"). Đổi xong chạy lại ./install.sh.
MERGE_SCHEDULE=*-*-* 12:00:00;*-*-* 18:00:00

# ---- Server test: deploy + QA tự động (deploy_qa.py, soar_api.py) ---------------------------------------------------
DEPLOY_HOST=192.0.2.10
DEPLOY_SSH_USER=ubuntu
# Mật khẩu SSH (bí mật — có thể để trong deploy.json).
DEPLOY_SSH_PASSWORD=
# Thư mục docker compose trên server.
DEPLOY_BASE=~/soar_v2.0
DEPLOY_FE_URL=https://soar.example.com:4443
DEPLOY_API_URL=https://soar-api.example.com:4443
# Tài khoản ứng dụng dùng để gọi API (mật khẩu + OTP là bí mật — có thể để trong deploy.json).
DEPLOY_APP_USER=tencuaban
DEPLOY_APP_PASSWORD=
DEPLOY_APP_OTP=
# Tài khoản QA mặc định (khai báo trong deploy.json → "accounts").
DEPLOY_DEFAULT_ACCOUNT=QA_superadmin
# Tên service / image / container / nhánh release trên server.
DEPLOY_FE_SERVICE=soar-fe-nginx
DEPLOY_BE_SERVICE=service-product-content
DEPLOY_FE_IMAGE=soar-fe-ss
DEPLOY_BE_IMAGE=soar-be-ss-lastest-k8s
DEPLOY_BE_RELEASE_BRANCH=release-ss/lastest-k8s
DEPLOY_BE_CONTAINER=soar
# Chờ server lên sau deploy / chờ khi gặp 502-504 (phút).
DEPLOY_WAIT_MINUTES=15
DEPLOY_SERVER_RETRY_MINUTES=10
# Cách đưa image mới vào chạy (README "Deploy không dừng trang"):
#   bluegreen = container tạm <tên>-next chạy bản mới, kiểm tra sống rồi mới chuyển nginx; lỗi thì giữ bản cũ.
#               Server chưa tách upstream nginx ra file riêng → tự dùng service.
#   service   = chỉ tạo lại FE/BE đổi image (--no-deps) + reload nginx — trang dừng ngắn.
#   recreate  = cách cũ: docker compose up -d --force-recreate cả stack.
DEPLOY_STRATEGY=bluegreen
# Phần dùng bluegreen (phần còn lại dùng service), vd "fe" nếu chưa muốn chạy song song 2 BE.
DEPLOY_BLUEGREEN_PARTS=fe,be
DEPLOY_NGINX_CONTAINER=soar-https-nginx
DEPLOY_NGINX_SERVICE=soar-https-nginx
DEPLOY_FE_CONTAINER=soar-fe
# Tên upstream nginx + file upstream riêng (tương đối DEPLOY_BASE, trong thư mục mount vào /etc/nginx/conf.d).
DEPLOY_BG_FE_UPSTREAM=soar_frontend_4443
DEPLOY_BG_BE_UPSTREAM=soar_backend_4443
DEPLOY_BG_FE_UPSTREAM_FILE=nginx-config/op-watch-upstream-fe.conf
DEPLOY_BG_BE_UPSTREAM_FILE=nginx-config/op-watch-upstream-be.conf
DEPLOY_BG_FE_PORT=3000
DEPLOY_BG_BE_PORT=8888
# Chờ container tạm / chính sống tối đa N phút; chờ request dở N giây trước khi xoá container tạm.
DEPLOY_BG_HEALTH_MINUTES=10
DEPLOY_BG_DRAIN_SECONDS=15
DEPLOY_BG_BE_HEALTH_PATH=/actuator/health
# BE tạm nhận alias mạng "soar" (playbook gọi http://soar:8888) trong lúc container chính tạo lại.
DEPLOY_BG_BE_ALIASES=true
# BE có migration Liquibase phá cấu trúc (drop / rename / đổi kiểu cột…): fallback = dùng service cho BE; ignore = vẫn bluegreen.
DEPLOY_BG_BE_DESTRUCTIVE=fallback
# QA đạt → chuyển ticket cho người này (id + tên hiển thị trong comment).
QA_USER_ID=123
QA_USER_NAME="anh QA"
# QA bằng gemini (agy) hoặc claude.
QA_ENGINE=gemini
QA_MODEL=gemini-3.8-flash-medium
QA_ROUNDS=6
QA_CALLS_PER_ROUND=8
# Giới hạn mỗi lần gọi Gemini khi QA (giây); hết giờ thì thử lại vòng đó 1 lần
QA_CALL_TIMEOUT=240
# Tài khoản tester QA được dùng khi ticket ghi sẵn tên + mật khẩu (cách nhau dấu phẩy). Mỗi lần QA đăng nhập sẽ
# đăng xuất phiên trình duyệt của người đang dùng tài khoản đó. Trống = chỉ tài khoản mặc định + QA_AUTO_* tự tạo.
#QA_TICKET_ACCOUNTS=tester_a,tester_b
# Trạng thái (id) của ticket giao cho mình cũng được QA lại trên server; ĐẠT → chuyển Resolved + người QA (vd 98 = Review)
#QA_REVIEW_STATUSES=98
# QA không đạt → autofix sửa tiếp tối đa chừng này lần rồi chuyển cần người quyết định.
QA_FAIL_AUTOFIX_MAX=2
# Số ticket QA song song (chỉnh trên dashboard, JSON thắng).
#QA_PARALLEL=3

# ---- Dashboard ------------------------------------------------------------------------------------------------------
# Trang chỉ nghe trên 127.0.0.1.
DASHBOARD_PORT=8765

# ---- Báo cáo ngày (daily_report.py) ---------------------------------------------------------------------------------
DAILY_REPORT_DIR=~/Downloads/bao-cao-ngay
DAILY_REPORT_MAX_ITEMS=5
# Trạng thái tính là "đang làm": New, Reopened, TO DO, In progress, UNREVIEWED.
DAILY_REPORT_OPEN_STATUSES=1,100,97,7,94
# Lịch op-report.timer (systemd OnCalendar). Đổi xong chạy lại ./install.sh.
REPORT_SCHEDULE=Mon..Fri *-*-* 08:00:00

# ===== Cập nhật hạn mức gói Claude chạy ngầm (op-limits.timer → op_autofix.py --probe) =====
# Lịch systemd OnCalendar, nhiều mốc cách nhau dấu ";". Đổi xong chạy lại ./install.sh op-limits.
LIMITS_SCHEDULE=*-*-* 08:00:00

# ===== Yêu cầu tester qua Telegram (tg_watch.py + tg_requests.py, service op-telegram) =====
# Userbot đăng nhập bằng tài khoản Telegram của bạn, chỉ nghe chat riêng với các tester dưới đây.
# Các giá trị dưới đây chỉnh được trên trang theo dõi (Telegram → ⚙ Cài đặt, lưu vào TG_CONFIG, mặc định
# ~/.config/op-watch/telegram.json) — giá trị trên trang thắng .env; ở đây chỉ là giá trị ban đầu.
# Cần: python3 -m pip install --user telethon; đăng nhập 1 lần: python3 tg_watch.py --login
# API id / hash: https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Nguồn chat (người / nhóm): nên chọn trên trang theo dõi (⚙ Cài đặt → Nguồn chat). Ở đây chỉ là giá trị ban đầu:
# @username hoặc ID số (nhóm là số âm), cách nhau dấu phẩy — nhóm mặc định chỉ nhận tin nhắc tới mình.
TG_CHATS=
# (cũ, vẫn đọc được) danh sách tester chat riêng
# TG_TESTERS=
# File phiên Telegram (quyền 600 — tương đương quyền vào tài khoản, không chia sẻ / commit)
TG_SESSION=~/.config/op-watch/telegram
# Các tin liên tiếp của tester cách nhau không quá N giây gom thành một yêu cầu
TG_GROUP_WINDOW=120
# all: mọi nhóm tin của tester thành yêu cầu chờ duyệt | hashtag: chỉ tin có TG_REQUEST_TAGS
TG_DETECT_MODE=all
TG_REQUEST_TAGS=#bug,#yc,#request,#task,#feature
TG_MAX_MEDIA_MB=20
# Gửi tin trả lời cho tester (từ tài khoản của bạn) khi tạo task / gắn việc / từ chối / việc xong
TG_NOTIFY_TESTER=0
# Trạng thái work package coi là xong (báo tester 1 lần)
TG_DONE_STATUSES=Resolved,Closed
TG_SYNC_MINUTES=5
# Mẫu tin trả lời ({title}, {display_id}, {reason}, {status}); \n = xuống dòng
# TG_MSG_CREATED=✅ Đã tiếp nhận: {title}\nMã việc: {display_id}
# TG_MSG_LINKED=✅ Đã ghi nhận bổ sung vào {display_id}: {title}
# TG_MSG_REJECTED=❌ Chưa tiếp nhận: {title}\nLý do: {reason}
# TG_MSG_DONE=🎉 {display_id} đã xử lý ({status}): {title}. Nhờ bạn kiểm tra lại giúp.
